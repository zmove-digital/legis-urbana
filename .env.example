# Copie para .env e ajuste conforme necessario.
# Todas as variaveis tem valor padrao e a aplicacao funciona sem nenhuma delas.

# Conexao do banco (SQLite por padrao; Postgres: postgresql+psycopg://user:pass@host/db)
LEGIS_DB_URL=sqlite:///data/legis.db

# Pasta com as cidades em YAML
LEGIS_DATA_DIR=./data

# Recarrega a base legal do YAML ao iniciar a aplicacao (1 = sim, 0 = nao)
LEGIS_SEED_ON_STARTUP=1
